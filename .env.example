# Public: safe in the browser, protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never expose to the browser, never commit real values.
# Needed only by POST /api/commands (the Submit button).
SUPABASE_SERVICE_ROLE_KEY=

# Server only. Shared secret for POST /api/critic; the worker sends it as the x-critic-secret header.
CRITIC_SHARED_SECRET=